# Wzór konfiguracji produkcyjnej. Na serwerze: cp .env.production.example .env.production,
# uzupełnić wartości (hasła: openssl rand -base64 24), APP_KEY: php artisan key:generate --show.
APP_NAME=Udzio
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://udzio.example
APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_DATABASE=udzio
DB_USERNAME=udzio
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

WEB_PORT=80
